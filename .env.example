# ---- Server ----
PORT=8080
GIN_MODE=release
APP_TIMEZONE=Asia/Jakarta          # dipakai untuk menentukan batas "hari ini"
CORS_ALLOWED_ORIGINS=*             # pisahkan dengan koma, atau isi domain frontend
AUTO_MIGRATE=true                  # jalankan GORM AutoMigrate saat start

# ---- MySQL ----
# Di Railway cukup referensikan: MYSQL_URL=${{MySQL.MYSQL_URL}}
MYSQL_URL=
# Atau untuk lokal:
DB_DSN=nutrai:nutrai@tcp(127.0.0.1:3306)/nutrai?charset=utf8mb4&parseTime=True&loc=UTC

# ---- n8n ----
N8N_SCAN_WEBHOOK_URL=https://your-n8n.example.com/webhook/nutrai-scan
N8N_CHAT_WEBHOOK_URL=https://your-n8n.example.com/webhook/nutrai-chat
N8N_WEBHOOK_SECRET=change-me        # dikirim sebagai header X-N8N-SECRET (validasi di n8n)
N8N_TIMEOUT_SECONDS=45              # timeout per percobaan
N8N_MAX_RETRIES=1                   # retry untuk error jaringan / 5xx

# ---- Gambar menu ----
# Gambar dicari di <FOOD_IMAGE_BASE_URL>/<slug>.jpg (lihat docs/food-images-manifest.csv).
# Contoh: https://nutrai-api.up.railway.app/static/foods  (file ada di folder static/foods) atau URL CDN/R2/S3.
FOOD_IMAGE_BASE_URL=

# ---- Upload ----
MAX_UPLOAD_MB=5
